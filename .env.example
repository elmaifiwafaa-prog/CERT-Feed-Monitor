# Gmail API OAuth2. The default mode creates and journals PDFs without sending them.
GMAIL_MODE=dry-run
GMAIL_FROM=
GMAIL_OAUTH_TOKEN=data/gmail-token.json
# Required only to bootstrap an OAuth token interactively in a development session.
GMAIL_OAUTH_CLIENT_SECRETS=
GMAIL_OAUTH_PORT=8080
NVD_API_KEY=
POLL_INTERVAL_HOURS=6
# Ignore CVE publications / CTI additions older than this window.
NEW_VULNERABILITY_DAYS=30
